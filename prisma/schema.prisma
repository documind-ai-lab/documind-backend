generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["documind_backend"]
}

enum ProjectType {
  ESTIMATE_REVIEW
  PROPOSAL_REVIEW
  CONTRACT_REVIEW
  MEETING_SUMMARY
  GENERAL_ANALYSIS

  @@schema("documind_backend")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED

  @@schema("documind_backend")
}

enum DocumentStatus {
  TEXT_EXTRACTION_PENDING
  TEXT_EXTRACTING
  READY
  FAILED

  @@schema("documind_backend")
}

enum OrphanDocumentFileStatus {
  PENDING
  CLEANED

  @@schema("documind_backend")
}

model Project {
  id                 String        @id @db.Uuid
  ownerId            String        @map("owner_id") @db.Uuid
  name               String        @db.VarChar(100)
  description        String?       @db.VarChar(1000)
  type               ProjectType
  status             ProjectStatus @default(ACTIVE)
  documentCount      Int           @default(0) @map("document_count")
  riskCandidateCount Int           @default(0) @map("risk_candidate_count")
  createdAt          DateTime      @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @map("updated_at") @db.Timestamptz(6)
  lastActivityAt     DateTime      @map("last_activity_at") @db.Timestamptz(6)
  documents          Document[]

  @@index([status, lastActivityAt, id], map: "idx_projects_status_last_activity_id")
  @@map("projects")
  @@schema("documind_backend")
}

model Document {
  id              String         @id @db.Uuid
  projectId       String         @map("project_id") @db.Uuid
  ownerId         String         @map("owner_id") @db.Uuid
  originalName    String         @map("original_name") @db.VarChar(255)
  storageProvider String         @default("local") @map("storage_provider") @db.VarChar(32)
  storageKey      String         @map("storage_key") @db.VarChar(1000)
  mimeType        String         @map("mime_type") @db.VarChar(255)
  extension       String         @db.VarChar(16)
  sizeBytes       Int            @map("size_bytes")
  status          DocumentStatus @default(TEXT_EXTRACTION_PENDING)
  failureReason   String?        @map("failure_reason") @db.VarChar(1000)
  createdAt       DateTime       @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @map("updated_at") @db.Timestamptz(6)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt, id], map: "idx_documents_project_created_id")
  @@map("documents")
  @@schema("documind_backend")
}

model OrphanDocumentFile {
  id              String                   @id @db.Uuid
  storageProvider String                   @default("local") @map("storage_provider") @db.VarChar(32)
  storageKey      String                   @unique @map("storage_key") @db.VarChar(1000)
  reason          String                   @db.VarChar(100)
  status          OrphanDocumentFileStatus @default(PENDING)
  attemptCount    Int                      @default(0) @map("attempt_count")
  lastError       String?                  @map("last_error") @db.VarChar(1000)
  nextRetryAt     DateTime                 @map("next_retry_at") @db.Timestamptz(6)
  cleanedAt       DateTime?                @map("cleaned_at") @db.Timestamptz(6)
  createdAt       DateTime                 @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextRetryAt, createdAt, storageKey], map: "idx_orphan_document_files_due")
  @@map("orphan_document_files")
  @@schema("documind_backend")
}
